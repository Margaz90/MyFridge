rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() && request.auth.uid in get(/databases/$(db)/documents/households/$(hid)).data.members;
    }

    // Ogni utente vede solo il proprio profilo (che contiene il codice della sua casa)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      // Il codice d'invito è l'ID del documento: chi lo conosce può leggerlo per entrare
      allow get: if signedIn();
      allow list: if false;
      // Nuova casa: chi la crea è l'unico membro e registra solo la propria email
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.memberEmails.keys().hasOnly([request.auth.uid])
        && request.resource.data.memberEmails[request.auth.uid] == request.auth.token.email;
      allow update: if signedIn() && (
        ( // i membri possono solo rinominare la casa: nessuno può togliere gli altri o cambiarne l'email
          request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        ) ||
        ( // ingresso con codice: si può solo aggiungere se stessi, con la propria email
          !(request.auth.uid in resource.data.members) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberEmails']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.memberEmails.diff(resource.data.memberEmails).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.memberEmails[request.auth.uid] == request.auth.token.email
        )
      );
      allow delete: if false;

      // Prodotti in casa e catalogo: solo i membri
      match /{sub}/{doc} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
